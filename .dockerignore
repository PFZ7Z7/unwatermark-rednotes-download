# ─── 源码与 IDE ──────────────────────────
.git
.gitignore
.github
.vscode
.idea
*.md
!frontend/README.md

# ─── 依赖与构建产物（容器内重新装/构建）─────
**/node_modules
**/dist
**/build
**/.turbo
**/.cache

# ─── 环境变量（docker 用 docker-compose.yml 注入）
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.docker.example

# ─── 开发期文件 ──────────────────────────
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.DS_Store
**/Thumbs.db

# ─── 后端调试 / 测试残留 ─────────────────
backend/debug.ts
backend/debug.js
backend/test_*.jpg
backend/test_*.png

# ─── 前端调试 ───────────────────────────
frontend/coverage
frontend/playwright-report
frontend/test-results

# ─── Docker 自身 ────────────────────────
Dockerfile
docker-compose.yml
.dockerignore
