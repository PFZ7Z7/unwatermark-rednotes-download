# ============================================================
# Docker Compose 配置示例
# 默认不需要 .env，直接执行 docker compose up -d --build 即可。
# 如需国内镜像源、公开端口或替换 MediaCrawler 源，再复制本文件为 .env 修改。
# ============================================================

# ─── 对外端口 ────────────────────────────────────────────────
# 生产反代建议保持 127.0.0.1；如需直接公网访问，改为 0.0.0.0
XHS_BIND_ADDR=127.0.0.1
XHS_PORT=3001

# ─── 国内镜像源适配（按需启用）──────────────────────────────
# NODE_IMAGE=public.ecr.aws/docker/library/node:20-slim
# PYTHON_IMAGE=python:3.11-slim-bookworm
# USE_ALIYUN_APT_MIRROR=true
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright

# ─── 驱动器版本固定 ──────────────────────────────────────────
MEDIACRAWLER_REPO=https://github.com/NanmiCoder/MediaCrawler.git
MEDIACRAWLER_REF=165776886faf56d44651d4dbd290b015582a97f2

# 如果 GitHub 无法访问，可将 MEDIACRAWLER_REPO 改为可访问的镜像仓库。
# 服务器实测可用：
# MEDIACRAWLER_REPO=https://gitcode.com/NanmiCoder/MediaCrawler.git

# ─── 可选：其余运行时参数（默认值在 docker-compose.yml 里）────
# 如需跨域前端，用逗号分隔；同源 Nginx 反代通常无需修改。
# ALLOWED_ORIGINS=https://xhs.example.com

# 默认连接 Compose 内的 xhs-driver；如需连接外部驱动器，可覆盖。
# MEDIACRAWLER_API=http://xhs-driver:8080

# 性能与缓存
# MEDIACRAWLER_CONCURRENCY=1
# RESULT_CACHE_TTL_MS=300000
# ZIP_COMPRESSION_LEVEL=3
# DOWNLOAD_JOB_TTL_MS=1800000
# DOWNLOAD_JOB_MAX_JOBS=50

# 磁盘保洁：只清理驱动器 data 下的历史 JSON，不碰登录数据
# RUNTIME_DATA_RETENTION_DAYS=3
# RUNTIME_DATA_MAX_JSON_FILES=200
# RUNTIME_CLEANUP_INTERVAL_MS=21600000
