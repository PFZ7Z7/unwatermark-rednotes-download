# ============================================================
# 后端服务配置示例
# 部署时复制为 .env 并按实际环境填写
# ============================================================

# 服务端口
PORT=3001

# 运行环境：development / production
# 设为 production 时，ALLOWED_ORIGINS 必填，否则服务拒绝启动
NODE_ENV=development

# 增强模式共享 Cookie 存储路径。
# 建议生产环境使用绝对路径，并确保只有服务运行用户可读写。
XHS_COOKIE_STORE_PATH=runtime/xhs-cookie.json

# ============================================================
# CORS 安全
# ============================================================

# 允许跨域的前端域名（逗号分隔）
# 同源 Nginx 反代场景可以留空，留空时使用开发态默认值（5173/3001 本机）
# 生产环境必填，例如：https://xhs.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 代理域名白名单（逗号分隔），限制 /api/proxy/* 只能访问小红书相关域名
PROXY_ALLOWED_HOSTS=xhscdn.com,xiaohongshu.com,xhslink.com

# ============================================================
# MediaCrawler 集成
# ============================================================

# MediaCrawler/驱动器 HTTP API 地址（Docker Compose 默认用 xhs-driver）
MEDIACRAWLER_API=http://localhost:8080

# MediaCrawler 浏览器数据目录（用于检测登录状态）
# Windows 示例: C:/Users/xxx/MediaCrawler/browser_data/xhs_user_data_dir
# Linux/Mac 示例: /home/xxx/MediaCrawler/browser_data/xhs_user_data_dir
# 强烈建议填绝对路径；相对路径依赖启动 cwd，PM2/systemd 下容易出错
MEDIACRAWLER_BROWSER_DATA=

# MediaCrawler 数据目录（爬取生成的 JSON/CSV 输出目录）
# 默认与 MediaCrawler 项目同层 (../MediaCrawler/data)；建议生产环境填绝对路径
MEDIACRAWLER_DATA_DIR=

# MediaCrawler 爬取并发度（透传给 --max_concurrency_num，默认 8）
MEDIACRAWLER_CONCURRENCY=8

# ============================================================
# 性能与缓存
# ============================================================

# 搜索/博主结果缓存 TTL（毫秒），同关键词+数量在该窗口内复用结果，默认 5 分钟
RESULT_CACHE_TTL_MS=300000

# ZIP 打包压缩等级，默认 3；图片/视频几乎不可压缩，不建议设置为 9
ZIP_COMPRESSION_LEVEL=3

# 批量下载任务保留时间与内存任务数量上限
DOWNLOAD_JOB_TTL_MS=1800000
DOWNLOAD_JOB_MAX_JOBS=50

# ============================================================
# 磁盘保洁
# ============================================================

# MediaCrawler data 目录 JSON 结果保留天数；0 表示不按天数清理
RUNTIME_DATA_RETENTION_DAYS=3

# MediaCrawler data 目录最多保留多少个 JSON 结果文件；0 表示不按数量清理
RUNTIME_DATA_MAX_JSON_FILES=200

# 后端启动后的定时保洁间隔（毫秒），默认 6 小时
RUNTIME_CLEANUP_INTERVAL_MS=21600000
