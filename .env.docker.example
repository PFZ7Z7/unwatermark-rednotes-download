# ─── 必填：宿主机上 MediaCrawler 目录的绝对路径（会挂载进容器）──────────
# Windows 示例（注意用正斜杠）：
#   MC_HOST_BROWSER_DATA=C:/Users/PFZ7Z7/MediaCrawler/browser_data
#   MC_HOST_DATA=C:/Users/PFZ7Z7/MediaCrawler/data
# Linux 示例：
#   MC_HOST_BROWSER_DATA=/opt/MediaCrawler/browser_data
#   MC_HOST_DATA=/opt/MediaCrawler/data
MC_HOST_BROWSER_DATA=
MC_HOST_DATA=

# 管理页面令牌。生产环境必须设置，不要提交真实值。
ADMIN_TOKEN=

# ─── 可选：其余运行时参数（默认值在 docker-compose.yml 里）────────────
# 如需暴露到公网 / 反代，填入前端访问用的 origin（逗号分隔）
# ALLOWED_ORIGINS=https://xhs.example.com

# MediaCrawler API 地址（跑在宿主机时保持默认即可）
# MEDIACRAWLER_API=http://host.docker.internal:8080

# 性能与缓存
# MEDIACRAWLER_CONCURRENCY=1
# RESULT_CACHE_TTL_MS=300000
# ZIP 打包已使用低内存流式写入；旧版 DOWNLOAD_CONCURRENCY 当前无需配置

# 磁盘保洁：只清理 MediaCrawler/data 下的历史 JSON，不碰登录数据
# RUNTIME_DATA_RETENTION_DAYS=3
# RUNTIME_DATA_MAX_JSON_FILES=200
# RUNTIME_CLEANUP_INTERVAL_MS=21600000
